#!/usr/bin/env bash
# zabbix-package-updates - monitoring-only Linux package update collector.
# It never installs, removes or upgrades packages.

set -u
set -o pipefail
PATH='/usr/sbin:/usr/bin:/sbin:/bin'
LC_ALL=C
LANG=C
export PATH LC_ALL LANG
umask 027

readonly VERSION='0.1.0-dev'
readonly CONFIG='/etc/zabbix-package-updates.conf'
readonly CACHE_DIR='/var/cache/zabbix-package-updates'
readonly RUN_DIR='/run/zabbix-package-updates'
readonly STAMP="${CACHE_DIR}/last_refresh"
readonly LOCK="${RUN_DIR}/collector.lock"

CHECK_ENABLED=yes
REFRESH_ENABLED=yes
REFRESH_INTERVAL=21600
COMMAND_TIMEOUT=120
APPLY_SECURITY_ENABLED=no
APPLY_ALL_ENABLED=no
AUTO_REBOOT=no

json_escape() {
    local s=${1-}
    s=${s//\\/\\\\}; s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

error_json() {
    local code=$1 msg=$2
    printf '{"schema_version":1,"status":"error","collector_version":"%s","timestamp":%s,"error_code":"%s","message":"%s"}\n' \
      "$VERSION" "$(date +%s 2>/dev/null || echo 0)" "$(json_escape "$code")" "$(json_escape "$msg")"
}

die() { error_json "$1" "$2"; exit "${3:-1}"; }

bool() {
    case "${1,,}" in yes|true|1|on) printf yes;; no|false|0|off) printf no;; *) return 1;; esac
}

load_config() {
    [[ -e "$CONFIG" ]] || return 0
    [[ -f "$CONFIG" && ! -L "$CONFIG" ]] || die INSECURE_CONFIG 'Configuration must be a regular file.' 78
    [[ $(stat -c '%u' "$CONFIG") == 0 ]] || die INSECURE_CONFIG 'Configuration must be owned by root.' 78
    local mode; mode=$(stat -c '%A' "$CONFIG")
    [[ ${mode:5:1} != w && ${mode:8:1} != w ]] || die INSECURE_CONFIG 'Configuration must not be group/other writable.' 78

    local line key value parsed
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || ${line:0:1} == '#' ]] && continue
        [[ $line == *=* ]] || die CONFIG_INVALID 'Invalid configuration line.' 78
        key=${line%%=*}; value=${line#*=}
        case "$key" in
            CHECK_ENABLED|REFRESH_ENABLED|APPLY_SECURITY_ENABLED|APPLY_ALL_ENABLED|AUTO_REBOOT)
                parsed=$(bool "$value") || die CONFIG_INVALID "Invalid boolean for $key." 78
                printf -v "$key" '%s' "$parsed"
                ;;
            REFRESH_INTERVAL|COMMAND_TIMEOUT)
                [[ $value =~ ^[0-9]+$ && $value -gt 0 ]] || die CONFIG_INVALID "Invalid integer for $key." 78
                printf -v "$key" '%s' "$value"
                ;;
            *) die CONFIG_INVALID "Unknown configuration key: $key." 78;;
        esac
    done < "$CONFIG"

    [[ $APPLY_SECURITY_ENABLED == no && $APPLY_ALL_ENABLED == no && $AUTO_REBOOT == no ]] || \
        die REMEDIATION_NOT_SUPPORTED 'This release is monitoring-only; remediation must remain disabled.' 78
}

secure_runtime() {
    [[ ! -L "$CACHE_DIR" && ! -L "$RUN_DIR" ]] || die INSECURE_DIRECTORY 'State directories must not be symlinks.' 73
    install -d -o root -g root -m 0750 "$CACHE_DIR" "$RUN_DIR" || die DIRECTORY_ERROR 'Unable to create secure state directories.' 73
}

refresh_due() {
    local now stamp=0
    now=$(date +%s)
    if [[ -f "$STAMP" && ! -L "$STAMP" ]]; then
        read -r stamp < "$STAMP" || stamp=0
        [[ $stamp =~ ^[0-9]+$ ]] || stamp=0
    fi
    (( stamp == 0 || now - stamp >= REFRESH_INTERVAL ))
}

mark_refresh() {
    local tmp now
    now=$(date +%s)
    tmp=$(mktemp "${CACHE_DIR}/last_refresh.XXXXXX") || return 1
    chmod 0640 "$tmp" && printf '%s\n' "$now" > "$tmp" && mv -f "$tmp" "$STAMP"
}

run_timeout() { timeout --signal=TERM --kill-after=10 "$COMMAND_TIMEOUT" "$@"; }

read_os() {
    OS_ID=unknown; OS_NAME='Unknown Linux'; OS_VERSION=unknown; OS_LIKE=''
    [[ -r /etc/os-release ]] || die OS_RELEASE_UNAVAILABLE 'Unable to read /etc/os-release.' 69
    local key value
    while IFS='=' read -r key value; do
        value=${value%\"}; value=${value#\"}; value=${value%\'}; value=${value#\'}
        case "$key" in ID) OS_ID=$value;; NAME) OS_NAME=$value;; VERSION_ID) OS_VERSION=$value;; ID_LIKE) OS_LIKE=$value;; esac
    done < /etc/os-release
    if [[ -x /usr/bin/pveversion && $(/usr/bin/pveversion 2>/dev/null) == pve-manager/* ]]; then
        OS_ID=proxmox; OS_NAME='Proxmox VE'
    fi
}

refresh_metadata() {
    [[ $REFRESH_ENABLED == yes ]] || return 0
    refresh_due || return 0
    case "$PM" in
        apt) DEBIAN_FRONTEND=noninteractive run_timeout apt-get -o Dpkg::Use-Pty=0 -o APT::Update::Error-Mode=any update >/dev/null 2>&1;;
        dnf5) run_timeout dnf5 -q makecache --refresh >/dev/null 2>&1;;
        dnf) run_timeout dnf -q makecache --refresh >/dev/null 2>&1;;
        *) return 0;;
    esac
    local rc=$?
    (( rc == 0 )) || die REPOSITORY_REFRESH_FAILED 'Unable to refresh repository metadata.' 69
    mark_refresh || die CACHE_WRITE_FAILED 'Repository metadata refreshed but timestamp could not be saved.' 73
}

emit_packages() {
    local first=1 line name arch installed available repo security
    printf '['
    while IFS=$'\t' read -r name arch installed available repo security; do
        [[ -n ${name:-} ]] || continue
        (( first )) || printf ','; first=0
        printf '{"name":"%s","architecture":"%s","installed":"%s","available":"%s","repository":"%s","security":%s}' \
          "$(json_escape "$name")" "$(json_escape "$arch")" "$(json_escape "$installed")" \
          "$(json_escape "$available")" "$(json_escape "$repo")" "$security"
    done < "$PACKAGES"
    printf ']'
}

collect_apt() {
    PM=apt; SECURITY_STATUS=heuristic
    command -v apt-get >/dev/null && command -v apt >/dev/null && command -v dpkg-query >/dev/null || \
        die PACKAGE_MANAGER_NOT_FOUND 'APT tools are unavailable.' 69
    refresh_metadata
    local out line package_repo rest available arch name repo installed security rc
    out=$(mktemp "${RUN_DIR}/apt.XXXXXX") || die TEMP_ERROR 'Unable to create temporary file.' 73
    run_timeout apt list --upgradable >"$out" 2>/dev/null; rc=$?
    (( rc == 0 )) || { rm -f "$out"; die PACKAGE_CHECK_FAILED 'APT failed to list available updates.' 69; }
    while IFS= read -r line; do
        [[ -n "$line" && "$line" != 'Listing...' && "$line" == */* ]] || continue
        package_repo=${line%% *}; rest=${line#* }; available=${rest%% *}; rest=${rest#* }; arch=${rest%% *}
        name=${package_repo%%/*}; repo=${package_repo#*/}
        installed=''; [[ $line == *'[upgradable from: '* ]] && { installed=${line#*'[upgradable from: '}; installed=${installed%']'}; }
        [[ -n "$installed" ]] || installed=$(dpkg-query -W -f='${Version}' "$name" 2>/dev/null || true)
        security=false; [[ ${repo,,} == *security* ]] && security=true
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$arch" "$installed" "$available" "$repo" "$security" >> "$PACKAGES"
    done < "$out"
    rm -f "$out"
}

collect_dnf5() {
    PM=dnf5; SECURITY_STATUS=supported
    command -v dnf5 >/dev/null && command -v rpm >/dev/null || die PACKAGE_MANAGER_NOT_FOUND 'DNF5/RPM tools are unavailable.' 69
    refresh_metadata
    local all sec name arch available repo installed key security
    all=$(mktemp "${RUN_DIR}/dnf5-all.XXXXXX"); sec=$(mktemp "${RUN_DIR}/dnf5-sec.XXXXXX") || die TEMP_ERROR 'Unable to create temporary file.' 73
    run_timeout dnf5 --cacheonly repoquery --upgrades --latest-limit=1 --queryformat $'%{name}\t%{arch}\t%{evr}\t%{repoid}\n' > "$all" 2>/dev/null || { rm -f "$all" "$sec"; die PACKAGE_CHECK_FAILED 'DNF5 failed to list available updates.' 69; }
    run_timeout dnf5 --cacheonly repoquery --upgrades --latest-limit=1 --security --queryformat $'%{name}\t%{arch}\t%{evr}\n' > "$sec" 2>/dev/null || SECURITY_STATUS=unknown
    while IFS=$'\t' read -r name arch available repo; do
        [[ -n "$name" ]] || continue
        installed=$(rpm -q --qf '%{EPOCHNUM}:%{VERSION}-%{RELEASE}\n' "$name.$arch" 2>/dev/null | head -n1 | sed 's/^0://' || true)
        security=null
        if [[ $SECURITY_STATUS == supported ]]; then
            key=$'\t'; if grep -Fqx "$name${key}$arch${key}$available" "$sec"; then security=true; else security=false; fi
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$arch" "$installed" "$available" "$repo" "$security" >> "$PACKAGES"
    done < "$all"
    rm -f "$all" "$sec"
}

collect_dnf() {
    PM=dnf; SECURITY_STATUS=unknown
    command -v dnf >/dev/null && command -v rpm >/dev/null || die PACKAGE_MANAGER_NOT_FOUND 'DNF/RPM tools are unavailable.' 69
    refresh_metadata
    local out line pkgarch available repo name arch installed
    out=$(mktemp "${RUN_DIR}/dnf.XXXXXX") || die TEMP_ERROR 'Unable to create temporary file.' 73
    run_timeout dnf -q --cacheonly list --upgrades > "$out" 2>/dev/null || { rm -f "$out"; die PACKAGE_CHECK_FAILED 'DNF failed to list available updates.' 69; }
    while read -r pkgarch available repo _; do
        [[ $pkgarch == *.* && $pkgarch != 'Available' ]] || continue
        name=${pkgarch%.*}; arch=${pkgarch##*.}
        installed=$(rpm -q --qf '%{EPOCHNUM}:%{VERSION}-%{RELEASE}\n' "$name.$arch" 2>/dev/null | head -n1 | sed 's/^0://' || true)
        printf '%s\t%s\t%s\t%s\t%s\tnull\n' "$name" "$arch" "$installed" "$available" "${repo:-unknown}" >> "$PACKAGES"
    done < "$out"
    rm -f "$out"
}

main() {
    (( $# == 0 )) || die INVALID_ARGUMENTS 'This collector accepts no command-line arguments.' 64
    (( EUID == 0 )) || die ROOT_REQUIRED 'Collector must run as root through the restricted sudo rule.' 77
    load_config
    [[ $CHECK_ENABLED == yes ]] || { printf '{"schema_version":1,"status":"disabled","collector_version":"%s","timestamp":%s}\n' "$VERSION" "$(date +%s)"; exit 0; }
    secure_runtime
    exec 9>"$LOCK" || die LOCK_ERROR 'Unable to open collector lock.' 73
    flock -n 9 || die COLLECTOR_BUSY 'Another collector process is already running.' 75
    PACKAGES=$(mktemp "${RUN_DIR}/packages.XXXXXX") || die TEMP_ERROR 'Unable to create package list.' 73
    chmod 0600 "$PACKAGES"; trap 'rm -f -- "$PACKAGES"' EXIT HUP INT TERM
    read_os
    local identity=" $OS_ID $OS_LIKE "
    if [[ $identity == *' debian '* || $OS_ID == ubuntu || $OS_ID == linuxmint || $OS_ID == proxmox ]]; then collect_apt
    elif command -v dnf5 >/dev/null 2>&1 && [[ $identity == *' rhel '* || $identity == *' fedora '* || $identity == *' centos '* || $OS_ID == rocky || $OS_ID == almalinux || $OS_ID == ol ]]; then collect_dnf5
    elif command -v dnf >/dev/null 2>&1 && [[ $identity == *' rhel '* || $identity == *' fedora '* || $identity == *' centos '* || $OS_ID == rocky || $OS_ID == almalinux || $OS_ID == ol ]]; then collect_dnf
    else die UNSUPPORTED_DISTRIBUTION "Unsupported Linux distribution: $OS_ID." 69; fi
    local total security_count=0 last_refresh=0 reboot=null reboot_status=unknown now
    total=$(wc -l < "$PACKAGES" | tr -d ' ')
    [[ $SECURITY_STATUS == supported || $SECURITY_STATUS == heuristic ]] && security_count=$(awk -F '\t' '$6=="true"{n++}END{print n+0}' "$PACKAGES")
    [[ -f /var/run/reboot-required ]] && { reboot=true; reboot_status=known; }
    [[ -f "$STAMP" ]] && { read -r last_refresh < "$STAMP" || last_refresh=0; [[ $last_refresh =~ ^[0-9]+$ ]] || last_refresh=0; }
    now=$(date +%s)
    printf '{"schema_version":1,"status":"ok","collector_version":"%s","timestamp":%s,' "$VERSION" "$now"
    printf '"distribution":{"id":"%s","name":"%s","version":"%s"},' "$(json_escape "$OS_ID")" "$(json_escape "$OS_NAME")" "$(json_escape "$OS_VERSION")"
    printf '"package_manager":"%s","refresh_enabled":%s,"refresh_interval":%s,' "$PM" "$([[ $REFRESH_ENABLED == yes ]] && echo true || echo false)" "$REFRESH_INTERVAL"
    printf '"updates":{"total":%s,"security":' "$total"
    if [[ $SECURITY_STATUS == supported || $SECURITY_STATUS == heuristic ]]; then printf '%s' "$security_count"; else printf 'null'; fi
    printf ',"security_status":"%s"},' "$SECURITY_STATUS"
    printf '"reboot_required":%s,"reboot_status":"%s","last_refresh":%s,"last_check":%s,"packages":' "$reboot" "$reboot_status" "$last_refresh" "$now"
    emit_packages; printf '}\n'
}

main "$@"
