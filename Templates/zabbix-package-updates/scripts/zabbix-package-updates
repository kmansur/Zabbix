#!/usr/bin/env bash
#
# zabbix-package-updates
#
# Security-focused Linux package update collector for Zabbix.
# Monitoring only: this program does not install, remove, or upgrade packages.
#

set -u
set -o pipefail

PATH='/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
LC_ALL='C'
LANG='C'
export LC_ALL LANG
umask 027

readonly PROGRAM_NAME='zabbix-package-updates'
readonly PROGRAM_VERSION='0.1.0-dev'
readonly SCHEMA_VERSION=1

readonly CONFIG_FILE='/etc/zabbix-package-updates.conf'
readonly CACHE_DIR='/var/cache/zabbix-package-updates'
readonly RUNTIME_DIR='/run/zabbix-package-updates'
readonly LAST_REFRESH_FILE="${CACHE_DIR}/last_refresh"
readonly LOCK_FILE="${RUNTIME_DIR}/collector.lock"

CHECK_ENABLED='yes'
REFRESH_ENABLED='yes'
REFRESH_INTERVAL=21600
COMMAND_TIMEOUT=120
APPLY_SECURITY_ENABLED='no'
APPLY_ALL_ENABLED='no'
AUTO_REBOOT='no'

OS_ID='unknown'
OS_NAME='Unknown Linux'
OS_VERSION='unknown'
OS_ID_LIKE=''
PACKAGE_MANAGER='unknown'
SECURITY_STATUS='unknown'
REBOOT_STATUS='unknown'
REBOOT_REQUIRED='null'
LAST_REFRESH=0
LAST_CHECK=0

APT_GET=''
APT=''
DPKG_QUERY=''
RPM=''
DNF=''
DNF5=''
YUM=''
TIMEOUT_BIN=''
FLOCK_BIN=''
STAT_BIN=''
READLINK_BIN=''

WORK_DIR=''
PACKAGES_FILE=''
SECURITY_KEYS_FILE=''

log_error() {
    printf '%s: %s\n' "${PROGRAM_NAME}" "$*" >&2
}

json_escape() {
    local value=${1-}
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    value=${value//$'\t'/\\t}
    printf '%s' "${value}"
}

json_string_or_null() {
    local value=${1-}
    if [[ -z "${value}" ]]; then
        printf 'null'
    else
        printf '"%s"' "$(json_escape "${value}")"
    fi
}

emit_error() {
    local code=$1
    local message=$2
    local now
    now=$(date +%s 2>/dev/null || printf '0')

    printf '{'
    printf '"schema_version":%d,' "${SCHEMA_VERSION}"
    printf '"status":"error",'
    printf '"collector_version":"%s",' "$(json_escape "${PROGRAM_VERSION}")"
    printf '"timestamp":%s,' "${now}"
    printf '"error_code":"%s",' "$(json_escape "${code}")"
    printf '"message":"%s"' "$(json_escape "${message}")"
    printf '}\n'
}

emit_disabled() {
    local now
    now=$(date +%s)

    printf '{'
    printf '"schema_version":%d,' "${SCHEMA_VERSION}"
    printf '"status":"disabled",'
    printf '"collector_version":"%s",' "$(json_escape "${PROGRAM_VERSION}")"
    printf '"timestamp":%s,' "${now}"
    printf '"message":"Package update monitoring is disabled locally."'
    printf '}\n'
}

trim() {
    local value=${1-}
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "${value}"
}

strip_optional_quotes() {
    local value=${1-}

    if [[ ${#value} -ge 2 && ${value:0:1} == '"' && ${value: -1} == '"' ]]; then
        value=${value:1:${#value}-2}
        value=${value//\\\"/\"}
        value=${value//\\\\/\\}
    elif [[ ${#value} -ge 2 && ${value:0:1} == "'" && ${value: -1} == "'" ]]; then
        value=${value:1:${#value}-2}
    fi

    printf '%s' "${value}"
}

parse_bool() {
    local value
    value=$(printf '%s' "${1-}" | tr '[:upper:]' '[:lower:]')

    case "${value}" in
        yes|true|1|on)
            printf 'yes'
            ;;
        no|false|0|off)
            printf 'no'
            ;;
        *)
            return 1
            ;;
    esac
}

parse_positive_integer() {
    local value=${1-}
    [[ "${value}" =~ ^[0-9]+$ ]] || return 1
    (( value > 0 )) || return 1
    printf '%d' "${value}"
}

load_config() {
    local line key value parsed line_number=0

    [[ -e "${CONFIG_FILE}" ]] || return 0
    validate_secure_file "${CONFIG_FILE}" 'Configuration file' || return 1

    while IFS= read -r line || [[ -n "${line}" ]]; do
        ((line_number += 1))
        line=$(trim "${line}")

        [[ -z "${line}" || ${line:0:1} == '#' ]] && continue
        [[ "${line}" == *'='* ]] || {
            emit_error 'CONFIG_INVALID_LINE' "Invalid configuration at line ${line_number}."
            return 1
        }

        key=$(trim "${line%%=*}")
        value=$(trim "${line#*=}")
        value=$(strip_optional_quotes "${value}")

        case "${key}" in
            CHECK_ENABLED)
                parsed=$(parse_bool "${value}") || {
                    emit_error 'CONFIG_INVALID_VALUE' "Invalid CHECK_ENABLED value."
                    return 1
                }
                CHECK_ENABLED=${parsed}
                ;;
            REFRESH_ENABLED)
                parsed=$(parse_bool "${value}") || {
                    emit_error 'CONFIG_INVALID_VALUE' "Invalid REFRESH_ENABLED value."
                    return 1
                }
                REFRESH_ENABLED=${parsed}
                ;;
            REFRESH_INTERVAL)
                parsed=$(parse_positive_integer "${value}") || {
                    emit_error 'CONFIG_INVALID_VALUE' "REFRESH_INTERVAL must be a positive integer."
                    return 1
                }
                REFRESH_INTERVAL=${parsed}
                ;;
            COMMAND_TIMEOUT)
                parsed=$(parse_positive_integer "${value}") || {
                    emit_error 'CONFIG_INVALID_VALUE' "COMMAND_TIMEOUT must be a positive integer."
                    return 1
                }
                COMMAND_TIMEOUT=${parsed}
                ;;
            APPLY_SECURITY_ENABLED)
                parsed=$(parse_bool "${value}") || {
                    emit_error 'CONFIG_INVALID_VALUE' "Invalid APPLY_SECURITY_ENABLED value."
                    return 1
                }
                APPLY_SECURITY_ENABLED=${parsed}
                ;;
            APPLY_ALL_ENABLED)
                parsed=$(parse_bool "${value}") || {
                    emit_error 'CONFIG_INVALID_VALUE' "Invalid APPLY_ALL_ENABLED value."
                    return 1
                }
                APPLY_ALL_ENABLED=${parsed}
                ;;
            AUTO_REBOOT)
                parsed=$(parse_bool "${value}") || {
                    emit_error 'CONFIG_INVALID_VALUE' "Invalid AUTO_REBOOT value."
                    return 1
                }
                AUTO_REBOOT=${parsed}
                ;;
            *)
                emit_error 'CONFIG_UNKNOWN_KEY' "Unknown configuration key: ${key}."
                return 1
                ;;
        esac
    done < "${CONFIG_FILE}"

    if [[ "${APPLY_SECURITY_ENABLED}" == 'yes' || "${APPLY_ALL_ENABLED}" == 'yes' || "${AUTO_REBOOT}" == 'yes' ]]; then
        emit_error 'REMEDIATION_NOT_SUPPORTED' 'This collector version is monitoring-only. Remediation and automatic reboot must remain disabled.'
        return 1
    fi
}

find_binary() {
    local variable_name=$1
    shift
    local candidate path

    for candidate in "$@"; do
        if path=$(command -v "${candidate}" 2>/dev/null); then
            printf -v "${variable_name}" '%s' "${path}"
            return 0
        fi
    done

    return 1
}


validate_secure_file() {
    local file=$1
    local description=$2
    local owner mode_string

    [[ -L "${file}" ]] && {
        emit_error 'INSECURE_FILE' "${description} must not be a symbolic link."
        return 1
    }

    [[ -f "${file}" ]] || {
        emit_error 'INSECURE_FILE' "${description} is not a regular file."
        return 1
    }

    owner=$("${STAT_BIN}" -c '%u' -- "${file}" 2>/dev/null) || {
        emit_error 'INSECURE_FILE' "Unable to verify ${description} ownership."
        return 1
    }

    mode_string=$("${STAT_BIN}" -c '